# Copy this file to .env and fill in one credential option:
# 1. an OpenAI-compatible API key; or
# 2. a local workspace credential CSV outside version control.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=
OPS_RAG_CREDENTIAL_FILE=

# Models (replace these defaults for your provider)
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
CREWAI_MODEL=openai/gpt-4o-mini
ENABLE_THINKING=false

# Project paths
OPS_RAG_SOURCE_DIR=./data
OPS_RAG_MANIFEST=./config/manifest.yaml
OPS_RAG_WORKING_DIR=./runtime/rag_storage
OPS_RAG_OUTPUT_DIR=./runtime/parser_output
OPS_RAG_AUDIT_LOG=./runtime/query_audit.jsonl
XDG_DATA_HOME=./runtime/crewai_data
CREWAI_STORAGE_DIR=ops_rag_knowledge

# RAG-Anything
PARSER=mineru
PARSE_METHOD=auto
MINERU_BACKEND=pipeline
MAX_CONCURRENT_FILES=1
TOP_K=20
CHUNK_TOP_K=10
MAX_TOTAL_TOKENS=12000
